SECRET_KEY=change-this-to-a-long-random-secret

FLASK_DEBUG=1

FLASK_RUN_PORT=8000

PORT=8000

DB_SERVER=JTCS\JTCS

DB_NAME=JTCSS

DB_DRIVER=ODBC Driver 17 for SQL Server

DB_TRUSTED_CONNECTION=1

# Required on VPS with ODBC Driver 18 + SQL Server self-signed SSL cert
DB_TRUST_SERVER_CERTIFICATE=1

APP_NAME=JTCS ERP

APP_VERSION=2026.1

# GoDaddy Titan / Workspace SMTP — credentials only from this file (never commit .env)
# Local + VPS must use the SAME mailbox password that works in Titan/GoDaddy webmail.

MAIL_SERVER=smtpout.secureserver.net

MAIL_PORT=465

MAIL_USE_TLS=False

MAIL_USE_SSL=True

MAIL_USERNAME=admin@jtcsxpert.com

# Do NOT wrap the password in quotes unless the password itself contains spaces.
MAIL_PASSWORD=YOUR_TITAN_PASSWORD

MAIL_DEFAULT_SENDER="Joshi Tax Consultancy & Services <admin@jtcsxpert.com>"

SUPPORT_EMAIL=admin@jtcsxpert.com

AUTH_TOKEN_EXPIRY_MINUTES=30

# Local:
# APP_BASE_URL=http://localhost:8000
# VPS / cloud (required — registration verify links must be a public URL, not localhost):
# APP_BASE_URL=http://app.jtcsexpert.com
# APP_BASE_URL=http://203.141.5.68:8000

APP_BASE_URL=http://localhost:8000

SERVER_NAME=

PREFERRED_URL_SCHEME=http

SESSION_LIFETIME_DAYS=14

# Optional: verify SMTP login once when the app starts (requires MAIL_PASSWORD)

SMTP_HEALTH_CHECK_ON_STARTUP=True

# Website Sales Executive applications (read-only from JTCS Web Page recruitment SQLite)
# RECRUITMENT_DB_PATH=D:\JTCS Web Page\recruitment\var\recruitment.db
# RECRUITMENT_UPLOAD_DIR=D:\JTCS Web Page\recruitment\var\uploads
# On VPS these default to /var/www/jtcsxpert.com/recruitment/var/...
# RECRUITMENT_PUBLIC_URL=https://jtcsxpert.com
# RECRUITMENT_SSO_SECRET=jtcs-xpert-recruitment-sso-v1

# Website Property marketplace (read-only from JTCS Web Page property SQLite)
# PROPERTY_DB_PATH=D:\JTCS Web Page\property\var\property.db
# PROPERTY_PUBLIC_URL=https://jtcsxpert.com
# PROPERTY_SSO_SECRET=jtcs-xpert-recruitment-sso-v1

# CRM / website intake (generate a long random key; website sends as X-API-Key)
WEBSITE_INTAKE_API_KEY=change-me-website-intake-api-key

# Communication Center — IMAP inbound email (defaults to MAIL_* credentials when blank)
IMAP_SERVER=imap.secureserver.net
IMAP_PORT=993
IMAP_USE_SSL=True
# IMAP_USERNAME=
# IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Notification / inbox AJAX poll interval (seconds)
NOTIFICATION_POLL_SECONDS=15

# Max upload size for CRM documents (MB)
MAX_CONTENT_LENGTH_MB=10

# Admin Role backups (optional)
# BACKUP_ROOT=E:\Git\JTCS Final\erp\backups
# BACKUP_KEEP_COUNT=20
# App copies .bak into BACKUP_ROOT after SQL Server writes to its own folder.
# Windows optional: SQL_SERVER_BACKUP_DIR=C:\Program Files\Microsoft SQL Server\...\MSSQL\Backup
# Linux VPS: leave unset (uses /var/opt/mssql/data). Do NOT use /tmp or /root.
# SQL_SERVER_BACKUP_DIR=
#
# Deploy / update_database.bat apply SCHEMA only (new tables/columns).
# Live SQL data is never restored or overwritten by push/deploy.
