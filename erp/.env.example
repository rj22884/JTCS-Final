SECRET_KEY=change-this-to-a-long-random-secret

FLASK_DEBUG=1

FLASK_RUN_PORT=8000

PORT=8000

DB_SERVER=JTCS\JTCS

DB_NAME=JTCSS

DB_DRIVER=ODBC Driver 17 for SQL Server

DB_TRUSTED_CONNECTION=1

# Required on VPS with ODBC Driver 18 + SQL Server self-signed SSL cert
DB_TRUST_SERVER_CERTIFICATE=1

APP_NAME=JTCS ERP

APP_VERSION=2026.1

# GoDaddy Titan / Workspace SMTP — credentials only from this file (never commit .env)
# Local + VPS must use the SAME mailbox password that works in Titan/GoDaddy webmail.

MAIL_SERVER=smtpout.secureserver.net

MAIL_PORT=465

MAIL_USE_TLS=False

MAIL_USE_SSL=True

MAIL_USERNAME=admin@jtcsxpert.com

MAIL_PASSWORD=YOUR_TITAN_PASSWORD

MAIL_DEFAULT_SENDER="Joshi Tax Consultancy & Services <admin@jtcsxpert.com>"

SUPPORT_EMAIL=admin@jtcsxpert.com

AUTH_TOKEN_EXPIRY_MINUTES=30

# Local:
# APP_BASE_URL=http://localhost:8000
# VPS / cloud (required so verification links are clickable):
# APP_BASE_URL=http://203.141.5.68:8000

APP_BASE_URL=http://localhost:8000

SERVER_NAME=

PREFERRED_URL_SCHEME=http

SESSION_LIFETIME_DAYS=14

# Optional: verify SMTP login once when the app starts (requires MAIL_PASSWORD)

SMTP_HEALTH_CHECK_ON_STARTUP=True

# Admin Role backups (optional)
# BACKUP_ROOT=E:\Git\JTCS Final\erp\backups
# BACKUP_KEEP_COUNT=20
# Windows: only set if SQL Server cannot write to BACKUP_ROOT\database
# Example: SQL_SERVER_BACKUP_DIR=C:\Program Files\Microsoft SQL Server\MSSQL16.JTCS\MSSQL\Backup
# Linux VPS: folder mssql can write (not under /root). Default tries /tmp/jtcs-sql-backup first.
# SQL_SERVER_BACKUP_DIR=
#
# Deploy / update_database.bat apply SCHEMA only (new tables/columns).
# Live SQL data is never restored or overwritten by push/deploy.
