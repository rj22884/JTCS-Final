SECRET_KEY=change-this-to-a-long-random-secret

FLASK_DEBUG=1

FLASK_RUN_PORT=8000

PORT=8000



DB_SERVER=JTCS\JTCS

DB_NAME=JTCSS

DB_DRIVER=ODBC Driver 17 for SQL Server

DB_TRUSTED_CONNECTION=1



APP_NAME=JTCS ERP

APP_VERSION=2026.1



# GoDaddy Titan SMTP — credentials read only from this file (never commit .env)

MAIL_SERVER=smtp.titan.email

MAIL_PORT=465

MAIL_USE_TLS=False

MAIL_USE_SSL=True

MAIL_USERNAME=admin@jtcsxpert.com

MAIL_PASSWORD=YOUR_TITAN_PASSWORD

MAIL_DEFAULT_SENDER="Joshi Tax Consultancy & Services <admin@jtcsxpert.com>"

SUPPORT_EMAIL=admin@jtcsxpert.com

AUTH_TOKEN_EXPIRY_MINUTES=30

APP_BASE_URL=http://localhost:8000

SERVER_NAME=

PREFERRED_URL_SCHEME=http

SESSION_LIFETIME_DAYS=14

# Optional: verify SMTP login once when the app starts (requires MAIL_PASSWORD)

SMTP_HEALTH_CHECK_ON_STARTUP=True

# Admin Role backups (optional). SQL Server service account must write to BACKUP_ROOT\database
# BACKUP_ROOT=E:\Git\JTCS Final\erp\backups
# BACKUP_KEEP_COUNT=20
