# Copy this file to deploy_vps.env and fill in the blanks.
# deploy_vps.env is gitignored. Do not put the SSH password here.
# Upload goes only to VPS_PATH. Do not point it at the JTCS app.

VPS_HOST=
VPS_USER=root
VPS_PORT=22
VPS_PATH=/var/www/whatsapp-crm
# Optional. Example: C:\Users\YOU\.ssh\whatsapp_crm  (preferred over root password)
VPS_SSH_KEY=
APP_PORT=3010
