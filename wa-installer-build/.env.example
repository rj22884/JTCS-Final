# Server-side only. Copy this file to .env.local and fill it in there.
# Never commit real tokens, and do not prefix these names with NEXT_PUBLIC_.

# First admin sign-in. Both are required to create that account on first boot.
# Use at least 8 characters. The password is stored as a scrypt hash.
# Leave both blank to skip automatic admin provisioning.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public app origin for admin approval links (fallback: WHATSAPP_WEBHOOK_URL origin).
APP_BASE_URL=

# Admin mobiles that receive WhatsApp approval requests after registrant OTP verify.
# Comma-separated. Never hard-code production numbers in source.
ADMIN_WHATSAPP_RECIPIENTS=
# AUTH_APPROVAL_WHATSAPP_NUMBERS=

# Optional Titan SMTP (not used for auth OTP/recovery — those use WhatsApp).
# Official Titan SMTP: smtp.titan.email — port 465 (SSL) or 587 (STARTTLS).
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp Business Account ID from Meta Business settings.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Phone number ID used by the Cloud API (not the display phone number).
WHATSAPP_PHONE_NUMBER_ID=

# Display number customers see, such as +91...
WHATSAPP_DISPLAY_PHONE=+918477005566

# Optional approved WhatsApp template for registration/reset OTP.
# Required for first-time recipients (outside the 24h session window).
# Body must include {{1}} for the 6-digit code.
# WHATSAPP_OTP_TEMPLATE=your_otp_template_name
# WHATSAPP_OTP_TEMPLATE_LANG=en
# WHATSAPP_OTP_TEMPLATE_BUTTON=off
# Button modes: off | copy_code | url


# Meta developer app id. This is not the app secret.
WHATSAPP_APP_ID=

# Meta Business ID. This is not the WhatsApp Business Account ID.
WHATSAPP_BUSINESS_ID=

# Graph API version, such as v21.0. Leave blank to use v21.0.
WHATSAPP_GRAPH_API_VERSION=

# System user or business access token. The app never sends this to the browser.
WHATSAPP_ACCESS_TOKEN=

# App secret used to verify X-Hub-Signature-256 on webhook POSTs.
WHATSAPP_APP_SECRET=

# Verify token you enter in the Meta webhook form. Do not invent a replacement here
# if the existing token is unknown.
WHATSAPP_VERIFY_TOKEN=

# Production webhook URL already registered with Meta, if you know it.
# Must be https and must not be localhost. Leave blank rather than guessing.
# Example shape: https://whatsapp.example.com/api/whatsapp/webhook
WHATSAPP_WEBHOOK_URL=

# CustomerMaster sync from JTCS ERP (name + phone only).
# Use the same value on app.jtcsxpert.com as WHATSAPP_CUSTOMER_SYNC_TOKEN.
ERP_BASE_URL=https://app.jtcsxpert.com
WHATSAPP_CUSTOMER_SYNC_TOKEN=

# Web Push (browser-closed + mobile notifications). Generate with:
#   npx web-push generate-vapid-keys --json
# Public key is safe for the browser; keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for VAPID (mailto:...). Defaults to ADMIN_EMAIL / SMTP_FROM.
# VAPID_SUBJECT=mailto:admin@ukdscwala.com

