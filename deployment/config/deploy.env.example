# =============================================================================
# JTCS ERP — Deployment environment (copy to deployment/deploy.env on VPS)
# NEVER commit deploy.env. Prefer SSH keys over passwords.
# =============================================================================

# Git remote name only — branch is ALWAYS passed by the deployer (BRANCH=…)
GIT_REMOTE=origin
# Do NOT hardcode production branch here. Windows console exports BRANCH.

# Absolute path to the cloned repo on the VPS
VPS_APP_DIR=/root/JTCS-final

# Relative to VPS_APP_DIR — where Flask lives
VPS_ERP_DIR=erp

# Virtualenv on VPS
VPS_VENV_DIR=/root/JTCS-final/erp/.venv

# Systemd unit name for Gunicorn
VPS_SYSTEMD_SERVICE=jtcs-erp

# Nginx reload if nginx is installed+enabled (soft-fail otherwise)
VPS_NGINX_RELOAD=1

# Health URLs
HEALTH_URL=http://127.0.0.1:8000/health
API_HEALTH_URL=http://127.0.0.1:8000/health
PUBLIC_HEALTH_URL=https://app.jtcsxpert.com/health

# Backup root on VPS
VPS_BACKUP_ROOT=/var/backups/jtcs-erp

# SQL Server backup (optional)
MSSQL_SERVER=
MSSQL_DATABASE=JTCSS
MSSQL_BACKUP_DIR=/var/backups/jtcs-erp/sql

# Deployment log directory on VPS
VPS_LOG_DIR=/var/log/jtcs-erp

DEFAULT_DEVELOPER=

# Flask env file on VPS
VPS_FLASK_ENV_FILE=/root/JTCS-final/erp/.env
