# =============================================================================
# JTCS ERP — Deployment environment (copy to deployment/deploy.env)
# NEVER commit deploy.env. Prefer SSH keys over passwords.
# =============================================================================

# --- GitHub / local Git ---
GIT_REMOTE=origin
GIT_BRANCH=main

# --- Ubuntu VPS SSH ---
# Example: deploy@203.0.113.10  OR  deploy@erp.example.com
VPS_SSH_HOST=deploy@YOUR_VPS_IP_OR_HOSTNAME
# Absolute path to private key on Windows (optional if agent/default key works)
# VPS_SSH_KEY=%USERPROFILE%\.ssh\jtcs_deploy_ed25519
VPS_SSH_KEY=
VPS_SSH_PORT=22

# Absolute path to the cloned repo on the VPS
VPS_APP_DIR=/var/www/jtcs-erp

# Relative to VPS_APP_DIR — where Flask lives
VPS_ERP_DIR=erp

# Virtualenv on VPS
VPS_VENV_DIR=/var/www/jtcs-erp/erp/.venv

# Systemd unit name for Gunicorn
VPS_SYSTEMD_SERVICE=jtcs-erp

# Nginx site name (optional reload via nginx -t && systemctl reload nginx)
VPS_NGINX_RELOAD=1

# Public health URL (must be reachable from VPS localhost or public)
HEALTH_URL=http://127.0.0.1:8000/health
# Optional API health (same as /health if not separate)
API_HEALTH_URL=http://127.0.0.1:8000/health

# Backup root on VPS (versioned folders created under this)
VPS_BACKUP_ROOT=/var/backups/jtcs-erp

# SQL Server backup (sqlcmd on VPS). Leave empty to skip DB backup.
# Example: tcp:127.0.0.1,1433
MSSQL_SERVER=
MSSQL_DATABASE=JTCSS
# Prefer Windows/SQL auth via env — do not put passwords in git.
# MSSQL_USER=
# MSSQL_PASSWORD=
# Or use a trusted/kerberos setup and leave user/password empty.
MSSQL_BACKUP_DIR=/var/backups/jtcs-erp/sql

# Deployment log directory on VPS
VPS_LOG_DIR=/var/log/jtcs-erp

# Default developer name (override at deploy time)
DEFAULT_DEVELOPER=

# Flask env file on VPS (for APP_VERSION sync)
VPS_FLASK_ENV_FILE=/var/www/jtcs-erp/erp/.env
