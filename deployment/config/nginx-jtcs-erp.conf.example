# JTCS ERP — Nginx reverse proxy example
# Install: copy to /etc/nginx/sites-available/jtcs-erp && enable site

upstream jtcs_erp {
    server 127.0.0.1:8000 fail_timeout=0;
}

server {
    listen 80;
    server_name erp.example.com;

    client_max_body_size 50m;

    location /static/ {
        alias /var/www/jtcs-erp/erp/app/static/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_pass http://jtcs_erp;
    }

    location = /health {
        proxy_pass http://jtcs_erp/health;
        access_log off;
    }
}
